@model IEnumerable<InventorySystem.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="page-header">
    <div>
        <h1>Orders</h1>
        <p>Customer orders. Creating an order reduces the stock of the product. If there is not enough stock, the order is rejected.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">New order</a>
</div>

<div class="panel panel-flush">
    @if (!Model.Any())
    {
        <div class="empty">No orders yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.Date)</th>
                        <th>@Html.DisplayNameFor(m => m.Product)</th>
                        <th>@Html.DisplayNameFor(m => m.Quantity)</th>
                        <th>@Html.DisplayNameFor(m => m.TotalPrice)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.Product?.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.TotalPrice.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2">Total</th>
                        <th>@Model.Sum(o => o.Quantity)</th>
                        <th>@Model.Sum(o => o.TotalPrice).ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>