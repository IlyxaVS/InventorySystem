@model IEnumerable<InventorySystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="page-header">
    <div>
        <h1>Suppliers</h1>
        <p>Companies that deliver goods to you. A supplier is chosen every time you create a supply.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add supplier</a>
</div>

<div class="panel panel-flush">
    @if (!Model.Any())
    {
        <div class="empty">No suppliers yet. Add your first supplier.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Phone)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>