@model InventorySystem.Models.Product

@{
    ViewData["Title"] = "Product details";
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p>All information about this product.</p>
    </div>
</div>

<div class="panel form-card">
    <dl class="row detail-list mb-4">
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Sku)</dt>
        <dd class="col-sm-7">@Model.Sku</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Category)</dt>
        <dd class="col-sm-7">@Model.Category?.Name</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Warehouse)</dt>
        <dd class="col-sm-7">@Model.Warehouse?.Name</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Price)</dt>
        <dd class="col-sm-7">@Model.Price.ToString("N2")</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Quantity)</dt>
        <dd class="col-sm-7">@Model.Quantity</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.MinQuantity)</dt>
        <dd class="col-sm-7">@Model.MinQuantity</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>