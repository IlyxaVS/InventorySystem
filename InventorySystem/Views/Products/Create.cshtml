@model InventorySystem.Models.Product

@{
    ViewData["Title"] = "Add product";
}

<div class="page-header">
    <div>
        <h1>Add product</h1>
        <p>Fill in the product details. The SKU must be unique. When the stock falls below the minimum stock, the system creates a supply request automatically.</p>
    </div>
</div>

<div class="panel form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control" />
            <div class="form-text">A unique code that identifies the product, for example LAP-001.</div>
            <span asp-validation-for="Sku" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="MinQuantity" class="form-label"></label>
                <input asp-for="MinQuantity" class="form-control" />
                <span asp-validation-for="MinQuantity" class="text-danger"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="WarehouseId" class="form-label"></label>
                <select asp-for="WarehouseId" class="form-select" asp-items="ViewBag.WarehouseId"></select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}