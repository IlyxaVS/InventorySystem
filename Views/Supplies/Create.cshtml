@model InventorySystem.Models.Supply

@{
    ViewData["Title"] = "New supply";
}

<div class="page-header">
    <div>
        <h1>New supply</h1>
        <p>Order goods from a supplier. The supply is saved as Pending, and the stock increases only after you press Receive on the Supplies page.</p>
    </div>
</div>

<div class="panel form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId"></select>
        </div>
        <div class="mb-3">
            <label asp-for="ProductId" class="form-label"></label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}