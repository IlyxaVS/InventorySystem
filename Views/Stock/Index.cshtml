@model IEnumerable<InventorySystem.Models.Product>

@{
    ViewData["Title"] = "Stock";
}

<h1>Stock levels</h1>
<p>Products with stock below the minimum are highlighted in red.</p>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Category</th>
            <th>Warehouse</th>
            <th>In stock</th>
            <th>Minimum</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr class="@(p.Quantity < p.MinQuantity ? "table-danger" : "")">
                <td>@p.Name</td>
                <td>@p.Sku</td>
                <td>@p.Category?.Name</td>
                <td>@p.Warehouse?.Name</td>
                <td>@p.Quantity</td>
                <td>@p.MinQuantity</td>
            </tr>
        }
    </tbody>
</table>