@model IEnumerable<InventorySystem.Models.Warehouse>

@{
    ViewData["Title"] = "Warehouses";
}

<div class="page-header">
    <div>
        <h1>Warehouses</h1>
        <p>The places where your products are stored. Every product is assigned to one warehouse.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add warehouse</a>
</div>

<div class="panel panel-flush">
    @if (!Model.Any())
    {
        <div class="empty">No warehouses yet. Add your first warehouse.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Address)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Address</td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>