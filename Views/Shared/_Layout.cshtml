@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => current == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Inventory</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Products")" asp-controller="Products" asp-action="Index">Products</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Stock")" asp-controller="Stock" asp-action="Index">Stock</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Supplies")" asp-controller="Supplies" asp-action="Index">Supplies</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Orders")" asp-controller="Orders" asp-action="Index">Orders</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">Reports</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Categories")" asp-controller="Categories" asp-action="Index">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Warehouses")" asp-controller="Warehouses" asp-action="Index">Warehouses</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Suppliers")" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger mt-3">@error</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">Inventory Management System</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>