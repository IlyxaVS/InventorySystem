@model InventorySystem.Models.Supplier

@{
    ViewData["Title"] = "Delete supplier";
}

<div class="page-header">
    <div>
        <h1>Delete supplier</h1>
        <p>Are you sure you want to delete this supplier? This cannot be undone, and records that depend on it may be removed as well.</p>
    </div>
</div>

<div class="panel form-card">
    <dl class="row detail-list mb-4">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-8">@Model.Name</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Phone)</dt>
        <dd class="col-sm-8">@Model.Phone</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>