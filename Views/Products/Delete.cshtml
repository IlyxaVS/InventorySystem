@model InventorySystem.Models.Product

@{
    ViewData["Title"] = "Delete product";
}

<div class="page-header">
    <div>
        <h1>Delete product</h1>
        <p>Are you sure you want to delete this product? This cannot be undone, and records that depend on it may be removed as well.</p>
    </div>
</div>

<div class="panel form-card">
    <dl class="row detail-list mb-4">
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-7">@Model.Name</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Sku)</dt>
        <dd class="col-sm-7">@Model.Sku</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Category)</dt>
        <dd class="col-sm-7">@Model.Category?.Name</dd>
        <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Quantity)</dt>
        <dd class="col-sm-7">@Model.Quantity</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>